# ── Omniroute Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Database ───────────────────────────────────────────────────────────
# PostgreSQL (preferred). SQLite fallback used if this is unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/omniroute
# DATABASE_URL=sqlite:///data/omniroute.db

# ── Email (Gmail) ──────────────────────────────────────────────────────
GMAIL_USER=jackhuhmate@gmail.com
GMAIL_APP_PASSWORD=
SIGN_NAME=Jake

# ── LLM (Groq) ─────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Deployment (Netlify) ───────────────────────────────────────────────
NETLIFY_TOKEN=

# ── Pipeline ───────────────────────────────────────────────────────────
DAILY_EMAIL_CAP=30
EMAIL_DELAY_SECONDS=45
LEAD_HUNTER_MAX=25
REPLY_SCAN_DAYS=3

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=logs/omniroute.log
